# Não preencha à mão: "pnpm neon:setup dev" gera apps/site/.env.local
# e "pnpm neon:setup production" gera apps/site/.env.vercel.production.
# Papel loja_site (somente leitura do catálogo).
DATABASE_URL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# true só no lançamento (libera Google)
NEXT_PUBLIC_SITE_INDEXABLE="false"
# Segredo compartilhado com o painel (atualiza o catálogo na hora após salvar).
REVALIDATE_SECRET=""
# Contato exibido no site (valores fictícios por padrão).
NEXT_PUBLIC_WHATSAPP_NUMBER="5500000000000"
NEXT_PUBLIC_WHATSAPP_DISPLAY="(00) 00000-0000"
NEXT_PUBLIC_INSTAGRAM="perfumaria.exemplo"
NEXT_PUBLIC_CONTACT_EMAIL=""
