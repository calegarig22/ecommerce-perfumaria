# Não preencha à mão: "pnpm neon:setup dev" gera apps/admin/.env.local.
# Papel loja_admin (escrita no catálogo; sem DDL).
DATABASE_URL=""
# Chave de criptografia de sessões e do segredo do 2FA (32+ bytes aleatórios).
BETTER_AUTH_SECRET=""
# Endereço público do painel (http://localhost:3001 em dev).
BETTER_AUTH_URL="http://localhost:3001"
# Site público (para atualizar o catálogo na hora após salvar).
SITE_URL="http://localhost:3000"
# Mesmo valor configurado no site.
REVALIDATE_SECRET=""
# Opcional — upload de fotos (Vercel Blob). Sem ele, upload fica desativado.
BLOB_READ_WRITE_TOKEN=""
# Opcional — e-mail de aviso a cada login (Resend).
RESEND_API_KEY=""
LOGIN_ALERT_FROM=""
# Opcional — leitura de foto/PDF/texto por IA em "Importar" (Gemini, plano grátis do Google AI Studio).
# No plano grátis o Google pode usar o conteúdo enviado (só material de catálogo vai para lá).
# Sem ela, a importação por planilha continua funcionando.
GEMINI_API_KEY=""
# Opcional — trocar o modelo se o Google aposentar o padrão (gemini-3.8-flash).
GEMINI_MODEL=""
